{
    "appearance": {
        "transparency": {
            "base": 0.9,
            "enabled": true,
            "layers": 0.4
        }
    },
    "background": {
        "desktopClock": {
            "enabled": true
        },
        "visualiser": {
            "autoHide": true,
            "enabled": true
        }
    },
    "launcher": {
        "actionPrefix": ":",
        "enableDangerousActions": true,
        "vimKeybinds": true
    },
    "services": {
        "smartScheme": false,
        "useFahrenheit": false
    },
    "session": {
        "commands": { "logout": ["hyprshutdown"] },
        "vimKeybinds": true
    }
}
